{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Hook Guard",
  "version": "0.1.0",
  "identifier": "com.goldenappleisland.claudehookguard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Hook Guard",
        "width": 400,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Golden Apple Island",
    "category": "DeveloperTool",
    "shortDescription": "Approval UI for Claude Code hooks running in WSL",
    "longDescription": "Claude Hook Guard is a Windows system tray app that intercepts Claude Code hook events from WSL and presents them as one-click approval cards, replacing the need to babysit terminal windows during long coding sessions.",
    "copyright": "Copyright (c) 2026 Golden Apple Island",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/CreeperLKF/GoldenAppleIsland",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "zh-CN"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {}
}
